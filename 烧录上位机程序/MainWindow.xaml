<ui:FluentWindow x:Class="烧录上位机程序.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:烧录上位机程序"
        xmlns:i18n="clr-namespace:烧录上位机程序.Services"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:material="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        mc:Ignorable="d"
        Title="{i18n:Loc 'J-Link 烧录上位机'}"
        Width="1280" Height="800"
        MinWidth="520" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <!-- 注：WPF-UI 规定 Mica 背景 必须 ExtendsContentIntoTitleBar=True（否则启动抛
         "Cannot apply backdrop effect..."），自绘标题栏成本高，故不开背景效果；
         Fluent 风格由 ControlsDictionary 的控件样式提供 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏：应用只保留固件烧录一个功能页，无页面导航 -->
        <Grid Grid.Row="0" Margin="20,12,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource AccentBrush}">
                    <material:MaterialIcon Kind="Flash" Width="20" Height="20"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{i18n:Loc 'J-Link 烧录上位机'}" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{i18n:Loc '固件烧录工具 · 基于 SEGGER J-Link DLL'}" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <ComboBox Grid.Column="1" x:Name="LanguageCombo"
                      Width="132" Height="34"
                      VerticalAlignment="Center"
                      HorizontalContentAlignment="Center"
                      SelectionChanged="LanguageCombo_SelectionChanged">
                <ComboBoxItem Content="简体中文" Tag="zh_CN"/>
                <ComboBoxItem Content="繁體中文" Tag="zh_TW"/>
                <ComboBoxItem Content="日本語" Tag="ja"/>
                <ComboBoxItem Content="한국어" Tag="ko"/>
                <ComboBoxItem Content="English" Tag="en"/>
                <ComboBoxItem Content="Français" Tag="fr"/>
            </ComboBox>
        </Grid>
        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1"
                Background="{StaticResource CardBorderBrush}" Margin="20,0"/>

        <!-- 内容区：Page 的可视父级只能是 Window/Frame，必须用 Frame 承载；
             显式 Stretch 防止页面按内容高度排版（否则日志区 * 行塌陷） -->
        <Frame Grid.Row="1" Content="{Binding CurrentPage}" NavigationUIVisibility="Hidden"
               HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
</ui:FluentWindow>
