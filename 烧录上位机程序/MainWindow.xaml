<Window x:Class="烧录上位机程序.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:烧录上位机程序"
        mc:Ignorable="d"
        Title="J-Link 烧录上位机"
        Width="1280" Height="800"
        MinWidth="480" MinHeight="540">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <DockPanel Grid.Row="0" Background="{DynamicResource SystemBaseLowColor}" MinHeight="48" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="J-Link 烧录上位机"
                       FontSize="16" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="8,0"/>

            <!-- 页面导航 -->
            <ListBox DockPanel.Dock="Left"
                     ItemsSource="{Binding Pages}"
                     SelectedItem="{Binding CurrentPage}"
                     Background="Transparent" BorderThickness="0"
                     VerticalAlignment="Center" Margin="16,0,0,0">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" Margin="10,6" FontSize="13"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ComboBox DockPanel.Dock="Right" x:Name="LanguageCombo"
                      Width="120" Margin="8,0"
                      VerticalAlignment="Center"
                      SelectionChanged="LanguageCombo_SelectionChanged">
                <ComboBoxItem Content="简体中文" Tag="zh_CN"/>
                <ComboBoxItem Content="繁體中文" Tag="zh_TW"/>
                <ComboBoxItem Content="日本語" Tag="ja"/>
                <ComboBoxItem Content="한국어" Tag="ko"/>
                <ComboBoxItem Content="English" Tag="en"/>
                <ComboBoxItem Content="Français" Tag="fr"/>
            </ComboBox>
        </DockPanel>

        <!-- 内容区 -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentPage}"/>
    </Grid>
</Window>
