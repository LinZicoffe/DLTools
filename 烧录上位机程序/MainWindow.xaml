<ui:FluentWindow x:Class="烧录上位机程序.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:烧录上位机程序"
        xmlns:i18n="clr-namespace:烧录上位机程序.Services"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:material="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        mc:Ignorable="d"
        Title="DL小工具"
        Width="1280" Height="800"
        MinWidth="1000" MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <!-- FluentWindow 的模板不含系统标题按钮且会剥离 WS_SYSMENU，窗口三键由
         标题栏右侧的自绘按钮提供（ui:TitleBar 在 Win11 26200 上点击无响应，
         见 UiStyles.xaml 的 CaptionButtonStyle 注释）；拖拽/双击最大化由
         标题栏行接管。未启用 Mica 背景，Fluent 控件风格由 ControlsDictionary 提供 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部品牌和自绘窗口按钮。 -->
        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="HeaderRoot_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,11,0,11">
                <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource AccentBrush}">
                    <material:MaterialIcon Kind="Flash" Width="20" Height="20"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="DL小工具" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="常用工具集合" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource CaptionButtonStyle}" Click="MinimizeButton_Click"
                        ToolTip="{i18n:Loc '最小化'}">
                    <material:MaterialIcon Kind="WindowMinimize" Width="14" Height="14"/>
                </Button>
                <Button Style="{StaticResource CaptionButtonStyle}" Click="MaximizeButton_Click"
                        ToolTip="{i18n:Loc '最大化'}">
                    <material:MaterialIcon x:Name="MaxButtonIcon" Kind="WindowMaximize" Width="13" Height="13"/>
                </Button>
                <Button Style="{StaticResource CaptionCloseButtonStyle}" Click="CloseButton_Click"
                        ToolTip="{i18n:Loc '关闭'}">
                    <material:MaterialIcon Kind="WindowClose" Width="14" Height="14"/>
                </Button>
            </StackPanel>
        </Grid>
        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1"
                Background="{StaticResource CardBorderBrush}" Margin="20,0"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0">
                <!-- StackPanel 与胶囊 Canvas 共用同一 Margin（坐标原点一致），胶囊按
                     按钮在 StackPanel 内的位置无级定位，选中态视觉由胶囊层承担 -->
                <Grid x:Name="NavHostGrid" Margin="12,16">
                    <StackPanel x:Name="NavItemsHost">
                        <Button Content="固件烧录" Command="{Binding ShowFlashCommand}"
                                Height="44" Margin="0,0,0,10">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers><DataTrigger Binding="{Binding IsFlashSelected}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="项目打包" Command="{Binding ShowPackagingCommand}"
                                Height="44" Margin="0,0,0,10">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers><DataTrigger Binding="{Binding IsPackagingSelected}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="离线授权" Command="{Binding ShowAuthorizationCommand}" Height="44" Margin="0,0,0,10">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers><DataTrigger Binding="{Binding IsAuthorizationSelected}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="IP 扫描" Command="{Binding ShowIpScanCommand}" Height="44" Margin="0,0,0,10">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers><DataTrigger Binding="{Binding IsIpScanSelected}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="IP 纯净度" Command="{Binding ShowIpPurityCommand}" Height="44" Margin="0,0,0,10">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers><DataTrigger Binding="{Binding IsIpPuritySelected}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="高速下载" Command="{Binding ShowDownloadCommand}" Height="44" Margin="0,0,0,10">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers><DataTrigger Binding="{Binding IsDownloadSelected}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="C盘清理" Command="{Binding ShowCleanupCommand}" Height="44">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers><DataTrigger Binding="{Binding IsCleanupSelected}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <!-- 液态玻璃选中胶囊：纯视觉层，不参与命中测试；宽度与位置由
                         MainWindow.xaml.cs 按选中按钮实时校正，动画见 PositionNavCapsule -->
                    <Canvas x:Name="NavCapsuleLayer" IsHitTestVisible="False">
                        <Border x:Name="NavCapsule" Canvas.Left="0" Canvas.Top="0"
                                Opacity="0"
                                Style="{StaticResource NavCapsuleStyle}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <TranslateTransform x:Name="NavCapsuleTranslate"/>
                                    <ScaleTransform x:Name="NavCapsuleScale"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <!-- 顶部白色→透明内反光 -->
                            <Border Height="13" Margin="12,3,12,0" VerticalAlignment="Top"
                                    CornerRadius="21"
                                    Background="{DynamicResource NavCapsuleHighlightBrush}"/>
                        </Border>
                    </Canvas>
                </Grid>
            </Border>
            <!-- 保持有界测量，让页面日志区的 * 行可用。页面实例由 ViewModel 缓存。 -->
            <Frame Grid.Column="1" Content="{Binding CurrentPage}" NavigationUIVisibility="Hidden"
                   HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
