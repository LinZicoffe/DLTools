<ui:FluentWindow x:Class="烧录上位机程序.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:烧录上位机程序"
        xmlns:i18n="clr-namespace:烧录上位机程序.Services"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:material="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        mc:Ignorable="d"
        Title="{i18n:Loc 'J-Link 烧录上位机'}"
        Width="1280" Height="800"
        MinWidth="520" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <!-- FluentWindow 的模板不含系统标题按钮且会剥离 WS_SYSMENU，窗口三键由
         标题栏右侧的自绘按钮提供（ui:TitleBar 在 Win11 26200 上点击无响应，
         见 UiStyles.xaml 的 CaptionButtonStyle 注释）；拖拽/双击最大化由
         标题栏行接管。未启用 Mica 背景，Fluent 控件风格由 ControlsDictionary 提供 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏：左侧品牌区，右侧最小化/最大化/关闭；
             应用只保留固件烧录一个功能页，无页面导航 -->
        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="HeaderRoot_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,11,0,11">
                <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource AccentBrush}">
                    <material:MaterialIcon Kind="Flash" Width="20" Height="20"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{i18n:Loc 'J-Link 烧录上位机'}" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{i18n:Loc '固件烧录工具 · 基于 SEGGER J-Link DLL'}" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource CaptionButtonStyle}" Click="MinimizeButton_Click"
                        ToolTip="{i18n:Loc '最小化'}">
                    <material:MaterialIcon Kind="WindowMinimize" Width="14" Height="14"/>
                </Button>
                <Button Style="{StaticResource CaptionButtonStyle}" Click="MaximizeButton_Click"
                        ToolTip="{i18n:Loc '最大化'}">
                    <material:MaterialIcon x:Name="MaxButtonIcon" Kind="WindowMaximize" Width="13" Height="13"/>
                </Button>
                <Button Style="{StaticResource CaptionCloseButtonStyle}" Click="CloseButton_Click"
                        ToolTip="{i18n:Loc '关闭'}">
                    <material:MaterialIcon Kind="WindowClose" Width="14" Height="14"/>
                </Button>
            </StackPanel>
        </Grid>
        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1"
                Background="{StaticResource CardBorderBrush}" Margin="20,0"/>

        <!-- 内容区：Page 的可视父级只能是 Window/Frame，必须用 Frame 承载；
             显式 Stretch 防止页面按内容高度排版（否则日志区 * 行塌陷） -->
        <Frame Grid.Row="1" Content="{Binding CurrentPage}" NavigationUIVisibility="Hidden"
               HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
</ui:FluentWindow>
