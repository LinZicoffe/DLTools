<Window x:Class="烧录上位机程序.Pages.AuthorizationPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="授权档案备份密码" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="White">
    <StackPanel Margin="24">
        <TextBlock x:Name="Prompt" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <TextBlock Text="使用 16～1024 个字符的独立强密码，不能使用六位授权码。备份密码忘记后不可恢复。"
                   TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>
        <TextBlock Text="密码" Margin="0,0,0,6"/>
        <PasswordBox x:Name="PasswordInput" MinHeight="36" MaxLength="1024" AutomationProperties.Name="备份密码"/>
        <StackPanel x:Name="ConfirmationPanel" Margin="0,12,0,0">
            <TextBlock Text="再次输入密码" Margin="0,0,0,6"/>
            <PasswordBox x:Name="ConfirmationInput" MinHeight="36" MaxLength="1024" AutomationProperties.Name="确认备份密码"/>
        </StackPanel>
        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" Margin="0,12,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Content="确认" IsDefault="True" Click="Accept_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="12,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
