<local:BasePage x:Class="烧录上位机程序.Pages.OfflineAuthorizationPage"
                Title="离线授权"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:local="clr-namespace:烧录上位机程序.Pages"
                Loaded="Page_Loaded">
    <local:BasePage.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </local:BasePage.Resources>
    <Grid Background="{StaticResource PageBgBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="22,18,22,16">
            <TextBlock Text="离线授权" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="选择设备，输入现场申请码，离线生成六位授权码。" Style="{StaticResource Hint}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="22,0,18,0">
            <StackPanel IsEnabled="{Binding IsIdle}">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="1  客户／设备档案" Style="{StaticResource Heading}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="DisplayName"
                                      MinHeight="36" AutomationProperties.Name="客户或设备档案"/>
                            <Button Grid.Column="1" Content="重新加载" Command="{Binding ReloadCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0"/>
                        </Grid>
                        <TextBlock Text="设备标识" Style="{StaticResource Hint}"/>
                        <TextBox Text="{Binding SelectedDeviceId, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 Padding="0,3" FontFamily="Consolas" AutomationProperties.Name="设备标识"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="新档案名称" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Style="{StaticResource Field}" AutomationProperties.Name="新档案名称"/>
                            <Button Grid.Column="2" Content="新建档案" Command="{Binding CreateCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0"/>
                            <TextBlock Grid.Row="1" Text="当前档案改名" VerticalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RenameName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Style="{StaticResource Field}" Margin="0,10,0,0" AutomationProperties.Name="当前档案名称"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="保存名称" Command="{Binding RenameCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="10,10,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="2  生成六位授权码" Style="{StaticResource Heading}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="现场申请码" VerticalAlignment="Center" Margin="0,0,18,0"/>
                            <TextBox Text="{Binding Challenge, UpdateSourceTrigger=PropertyChanged}" Width="180" FontFamily="Consolas" FontSize="24"
                                     Style="{StaticResource Field}" AutomationProperties.Name="六位申请码"/>
                            <Button Content="生成授权码" Command="{Binding GenerateCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="14,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ChallengeHint}" Style="{StaticResource Hint}"/>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Response, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="36" MinHeight="66"
                                     VerticalContentAlignment="Center" Foreground="{StaticResource AccentBrush}" AutomationProperties.Name="六位授权码"/>
                            <Button Grid.Column="1" Content="复制授权码" Command="{Binding CopyCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="12,0,0,0"/>
                        </Grid>
                        <TextBlock Text="更换档案或修改申请码后，旧结果会立即清空。" Style="{StaticResource Hint}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="3  我方档案备份" Style="{StaticResource Heading}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="创建加密备份" Click="Backup_Click" IsEnabled="{Binding IsStoreReady}" Style="{StaticResource SecondaryButtonStyle}"/>
                            <Button Content="从备份恢复" Click="Restore_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="12,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="备份仅供我方保管，客户不用操作文件。请使用独立强密码，并将密码与备份分开保存。" Style="{StaticResource Hint}"/>
                        <TextBlock Text="此页面是内部生成工具；客户软件需要预先接入相同设备密钥及验证逻辑。六位码不用于恢复丢失的密钥。" Style="{StaticResource Hint}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" Padding="22,12" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                <Button Grid.Column="1" Content="取消任务" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="14,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</local:BasePage>
