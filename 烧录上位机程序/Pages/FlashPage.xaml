<local:BasePage x:Class="烧录上位机程序.Pages.FlashPage"
                Title="固件烧录"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:local="clr-namespace:烧录上位机程序.Pages"
                xmlns:i18n="clr-namespace:烧录上位机程序.Services"
                xmlns:material="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF">
    <Grid Background="{StaticResource PageBgBrush}" TextElement.FontSize="13" TextElement.Foreground="{StaticResource TextPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" MinHeight="120"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*" MinHeight="160"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
        <!-- ============ 连接参数 ============ -->
        <GroupBox Grid.Row="0" Margin="16,12,16,0">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <material:MaterialIcon Kind="Chip" Width="17" Height="17" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="{i18n:Loc '连接参数'}" FontWeight="SemiBold" FontSize="14" Margin="8,0,0,0"/>
                </StackPanel>
            </GroupBox.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MaxWidth="230"/>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{i18n:Loc '目标设备:'}" Width="64" TextAlignment="Right"
                           VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="DeviceNameBox" Text="STM32H750VB"
                         Height="34" VerticalContentAlignment="Center"
                         ToolTip="{i18n:Loc 'SEGGER 支持的目标芯片名，须与官方设备列表一致'}"/>

                <TextBlock Grid.Row="0" Grid.Column="3" Text="{i18n:Loc '接口:'}" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <ComboBox Grid.Row="0" Grid.Column="4" x:Name="InterfaceCombo" Width="110" Height="34"
                          VerticalContentAlignment="Center">
                    <ComboBoxItem Content="SWD" IsSelected="True"/>
                    <ComboBoxItem Content="JTAG"/>
                </ComboBox>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{i18n:Loc '速度:'}" Width="64" TextAlignment="Right"
                           VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="SpeedBox" Text="4000" Width="100" Height="34"
                             VerticalContentAlignment="Center"
                             ToolTip="{i18n:Loc 'J-Link 下载速度，单位 kHz'}"/>
                    <TextBlock Text="kHz" VerticalAlignment="Center" Margin="8,0,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="3" Text="{i18n:Loc '序列号:'}" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal">
                    <TextBox x:Name="SerialBox" Width="130" Height="34" VerticalContentAlignment="Center"
                             ToolTip="{i18n:Loc '留空时自动连接第一个检测到的 J-Link'}"/>
                    <TextBlock Text="{i18n:Loc '留空自动'}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- ============ 固件文件 ============ -->
        <GroupBox Grid.Row="1" Margin="16,12,16,0">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <material:MaterialIcon Kind="File" Width="17" Height="17" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="{i18n:Loc '固件文件'}" FontWeight="SemiBold" FontSize="14" Margin="8,0,0,0"/>
                </StackPanel>
            </GroupBox.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBox Grid.Row="0" Grid.Column="0" x:Name="FilePathBox" Height="34"
                         VerticalContentAlignment="Center"
                         ToolTip="{i18n:Loc '支持 .hex / .axf / .elf / .bin'}"/>
                <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Click="BrowseFile_Click"
                        MinWidth="112" Height="34" Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <material:MaterialIcon Kind="FolderOpen" Width="15" Height="15"
                                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{i18n:Loc '浏览文件'}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="{i18n:Loc 'Bin 起始地址:'}" Width="88" TextAlignment="Right" VerticalAlignment="Center"
                               Margin="0,0,10,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox x:Name="BinAddrBox" Width="150" Height="30" VerticalContentAlignment="Center"
                             ToolTip="{i18n:Loc '仅 .bin 文件需要：烧录起始地址，如 0x08000000'}"/>
                    <TextBlock Text="{i18n:Loc '仅 .bin 需要（hex/elf 文件自带地址信息）'}" VerticalAlignment="Center"
                               Margin="8,0,0,0" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- ============ 烧录选项 ============ -->
        <GroupBox Grid.Row="2" Margin="16,12,16,0">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <material:MaterialIcon Kind="Tune" Width="17" Height="17" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="{i18n:Loc '烧录选项'}" FontWeight="SemiBold" FontSize="14" Margin="8,0,0,0"/>
                </StackPanel>
            </GroupBox.Header>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal">
                <StackPanel>
                    <TextBlock Text="{i18n:Loc '擦除模式'}" FontSize="11" Margin="0,0,0,6"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{i18n:Loc '整片擦除'}" GroupName="EraseMode" x:Name="EraseChip" Margin="0,0,16,0"
                                     ToolTip="{i18n:Loc '擦除整个芯片全部 Flash（含 bootloader 区域），确认目标无需保留内容时再用'}"/>
                        <RadioButton Content="{i18n:Loc '扇区擦除'}" GroupName="EraseMode" IsChecked="True" x:Name="EraseSector"
                                     ToolTip="{i18n:Loc '只擦除固件覆盖的扇区（默认，保护 bootloader）'}"/>
                    </StackPanel>
                </StackPanel>

                <Border Width="1" Background="{StaticResource CardBorderBrush}" Margin="24,0"/>

                <StackPanel>
                    <TextBlock Text="{i18n:Loc '完成后动作'}" FontSize="11" Margin="0,0,0,6"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{i18n:Loc '复位运行'}" GroupName="PostAction" IsChecked="True" x:Name="ResetRunRadio" Margin="0,0,16,0"
                                     ToolTip="{i18n:Loc '烧录完成后复位芯片并开始运行固件'}"/>
                        <RadioButton Content="{i18n:Loc '复位暂停'}" GroupName="PostAction" x:Name="ResetHaltRadio" Margin="0,0,16,0"
                                     ToolTip="{i18n:Loc '烧录完成后复位芯片并暂停在复位向量'}"/>
                        <RadioButton Content="{i18n:Loc '仅烧录'}" GroupName="PostAction"
                                     ToolTip="{i18n:Loc '烧录完成后不复位，芯片保持暂停'}"/>
                    </StackPanel>
                </StackPanel>

                <Border Width="1" Background="{StaticResource CardBorderBrush}" Margin="24,0"/>

                <StackPanel>
                    <TextBlock Text="{i18n:Loc '校验'}" FontSize="11" Margin="0,0,0,6"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal">
                        <material:MaterialIcon Kind="CheckCircle" Width="15" Height="15"
                                               Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{i18n:Loc '自动执行（烧录后读回比对）'}" VerticalAlignment="Center" Margin="7,0,0,0" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   ToolTip="{i18n:Loc '烧录完成后自动读回 Flash 与固件文件逐字节比对，不一致即报失败'}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </GroupBox>
        </StackPanel>
        </ScrollViewer>

        <!-- ============ 操作与进度 ============ -->
        <StackPanel Grid.Row="1" Margin="0,14,0,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="StartBtn" Click="StartFlash_Click" Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="150" Height="38" Margin="4">
                    <StackPanel Orientation="Horizontal">
                        <material:MaterialIcon Kind="Flash" Width="15" Height="15" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="{i18n:Loc '开始烧录'}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="StopBtn" Click="StopFlash_Click" Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="104" Height="38" Margin="4" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <material:MaterialIcon Kind="Stop" Width="13" Height="13"
                                               Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{i18n:Loc '停止'}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="StageText" Text="{i18n:Loc '就绪'}" VerticalAlignment="Center" Margin="16,0,0,0"
                           FontWeight="SemiBold" FontSize="14"/>
            </StackPanel>

            <DockPanel Margin="28,14,28,0">
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding Value, ElementName=ProgressBar, StringFormat={}{0:0}%}"
                           Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                           MinWidth="36" TextAlignment="Right"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <ProgressBar x:Name="ProgressBar" Height="8" Minimum="0" Maximum="100" Value="0"
                             Style="{StaticResource RoundedProgressStyle}" VerticalAlignment="Center"/>
            </DockPanel>
        </StackPanel>

        <!-- ============ 日志 ============ -->
        <GroupBox Grid.Row="2" Margin="16,0,16,14">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <material:MaterialIcon Kind="Console" Width="17" Height="17" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="{i18n:Loc '日志'}" FontWeight="SemiBold" FontSize="14" Margin="8,0,0,0"/>
                </StackPanel>
            </GroupBox.Header>
            <TextBox x:Name="LogBox" Style="{StaticResource LogConsoleStyle}" MinHeight="100"/>
        </GroupBox>
    </Grid>
</local:BasePage>
