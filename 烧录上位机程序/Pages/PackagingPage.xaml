<local:BasePage x:Class="烧录上位机程序.Pages.PackagingPage"
                Title="项目打包"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:local="clr-namespace:烧录上位机程序.Pages"
                Loaded="Page_Loaded">
    <local:BasePage.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,5,0,8"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="Browse" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="12,4"/>
        </Style>
    </local:BasePage.Resources>
    <Grid Background="{StaticResource PageBgBrush}" Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="170"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="145"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="20,16,20,8">
            <TextBlock Text="项目打包" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="导入 WinForms / WPF 项目，生成指定名称的 EXE 安装包" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,0,16,0">
            <StackPanel>
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel IsEnabled="{Binding IsIdle}">
                        <TextBlock Text="1  选择项目" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" ToolTip="本地项目文件夹、.sln 或 .csproj 的完整路径" AutomationProperties.Name="项目路径"/>
                            <Button Grid.Column="1" Content="项目文件" Command="{Binding BrowseSourceFileCommand}" Style="{StaticResource Browse}"/>
                            <Button Grid.Column="2" Content="文件夹" Command="{Binding BrowseSourceFolderCommand}" Style="{StaticResource Browse}"/>
                            <Button Grid.Column="3" Content="识别" Command="{Binding InspectCommand}" Style="{StaticResource Browse}"/>
                        </Grid>
                        <TextBlock Text="{Binding SelectionMessage}" Style="{StaticResource Hint}"/>
                        <ComboBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}" DisplayMemberPath="DisplayName" MinHeight="34" HorizontalContentAlignment="Stretch" AutomationProperties.Name="可执行项目和目标框架"/>
                        <TextBox Text="{Binding ProfileError, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" IsTabStop="False" Padding="0" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="2  查看识别结果" Style="{StaticResource SectionTitle}"/>
                        <TextBox Text="{Binding ProjectSummary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="0" IsTabStop="False"/>
                        <Grid IsEnabled="{Binding IsIdle}" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="配置" Style="{StaticResource Label}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Configurations}" Text="{Binding Configuration, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" IsEnabled="{Binding IsDirectProject}" MinHeight="32"/>
                            <TextBlock Grid.Column="2" Text="项目平台" Style="{StaticResource Label}" Margin="14,0,10,0"/>
                            <ComboBox Grid.Column="3" ItemsSource="{Binding Platforms}" Text="{Binding Platform, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" IsEnabled="{Binding IsDirectProject}" MinHeight="32"/>
                            <Button Grid.Column="4" Content="重新评估" Command="{Binding ReevaluateCommand}" IsEnabled="{Binding IsDirectProject}" Style="{StaticResource Browse}"/>
                        </Grid>
                        <TextBlock Text="直接导入的项目可切换配置与平台，修改后请重新评估再打包。解决方案使用候选列表中的 ActiveCfg 映射。" Style="{StaticResource Hint}"/>
                        <Expander Header="构建工具与路径设置" IsExpanded="False" IsEnabled="{Binding IsIdle}">
                            <StackPanel Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="dotnet.exe" Style="{StaticResource Label}"/>
                                    <TextBox Grid.Column="1" Text="{Binding DotNetPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"/>
                                    <Button Grid.Column="2" Content="浏览" Command="{Binding BrowseToolCommand}" CommandParameter="dotnet" Style="{StaticResource Browse}"/>
                                    <TextBlock Grid.Row="1" Text="MSBuild.exe" Style="{StaticResource Label}"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MsBuildPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" Margin="0,7,0,0"/>
                                    <Button Grid.Row="1" Grid.Column="2" Content="浏览" Command="{Binding BrowseToolCommand}" CommandParameter="msbuild" Style="{StaticResource Browse}" Margin="8,7,0,0"/>
                                    <TextBlock Grid.Row="2" Text="ISCC.exe" Style="{StaticResource Label}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding InnoCompilerPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" Margin="0,7,0,0"/>
                                    <Button Grid.Row="2" Grid.Column="2" Content="浏览" Command="{Binding BrowseToolCommand}" CommandParameter="inno" Style="{StaticResource Browse}" Margin="8,7,0,0"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="自动定位" Command="{Binding DetectToolsCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                                    <Button Content="检查工具" Command="{Binding CheckToolsCommand}" Style="{StaticResource Browse}"/>
                                </StackPanel>
                                <TextBox Text="{Binding ToolStatus, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" Margin="0,10,0,0"/>
                                <TextBlock Text="SDK / VS MSBuild 按所选项目需要使用；仅自动模板要求 Inno 简体中文语言文件。缺少工具时可在此指定安装路径。" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel IsEnabled="{Binding IsIdle}">
                        <TextBlock Text="3  配置安装包" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="输出目录" Style="{StaticResource Label}"/>
                            <TextBox Grid.Column="1" Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" AutomationProperties.Name="安装包输出目录"/>
                            <Button Grid.Column="2" Content="浏览" Command="{Binding BrowseOutputFolderCommand}" Style="{StaticResource Browse}"/>
                            <TextBlock Grid.Row="1" Text="安装包文件名" Style="{StaticResource Label}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding InstallerFileName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" Margin="0,7,0,0" AutomationProperties.Name="安装包文件名"/>
                            <TextBlock Grid.Row="2" Text="打包模式" Style="{StaticResource Label}"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding ModeNames}" SelectedIndex="{Binding ModeIndex}" MinHeight="32" Margin="0,7,0,0"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Text="安装包文件名只控制输出文件；安装后的应用名称和目标程序 EXE 分别处理，不会重命名程序入口。"/>
                        <Grid IsEnabled="{Binding IsModernProject}" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="发布架构" Style="{StaticResource Label}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding RuntimeIdentifiers}" SelectedItem="{Binding RuntimeIdentifier}" MinHeight="32"/>
                            <CheckBox Grid.Column="2" Content="独立部署（携带运行时）" IsChecked="{Binding SelfContained}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </Grid>
                        <TextBlock Text="{Binding RuntimeExplanation}" Style="{StaticResource Hint}"/>
                        <StackPanel IsEnabled="{Binding IsGeneratedMode}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="应用名称" Style="{StaticResource Label}"/>
                                <TextBox Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding AppName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"/>
                                <TextBlock Grid.Row="1" Text="应用版本" Style="{StaticResource Label}"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding AppVersion, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" Margin="0,7,0,0"/>
                                <TextBlock Grid.Row="2" Text="目标程序 EXE" Style="{StaticResource Label}"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding MainExecutable, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource Field}" Margin="0,7,0,0"/>
                                <TextBlock Grid.Row="3" Text="图标（可选）" Style="{StaticResource Label}"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding IconPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" Margin="0,7,0,0"/>
                                <Button Grid.Row="3" Grid.Column="2" Content="浏览" Command="{Binding BrowseIconCommand}" Style="{StaticResource Browse}" Margin="8,7,0,0"/>
                            </Grid>
                            <WrapPanel Margin="0,12,0,8">
                                <CheckBox Content="提供可选桌面快捷方式" IsChecked="{Binding CreateDesktopShortcut}" Margin="0,0,20,6"/>
                                <CheckBox Content="安装完成后允许启动应用" IsChecked="{Binding LaunchAfterInstall}" Margin="0,0,0,6"/>
                            </WrapPanel>
                            <Expander Header="额外资源与稳定安装标识" IsExpanded="False">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="资源目标是安装目录下的相对路径。文件需包含文件名；目录可填子目录或 . 合并到根目录。禁止越界、链接和覆盖已有文件。" Style="{StaticResource Hint}"/>
                                    <DataGrid ItemsSource="{Binding Resources}" SelectedItem="{Binding SelectedResource}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" MaxHeight="190" MinHeight="80" HeadersVisibility="Column" SelectionMode="Single">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="本地文件 / 目录" Binding="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                            <DataGridTextColumn Header="安装目录内相对目标" Binding="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <WrapPanel Margin="0,8,0,10">
                                        <Button Content="添加文件" Command="{Binding AddFilesCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                                        <Button Content="添加目录" Command="{Binding AddFolderCommand}" Style="{StaticResource Browse}"/>
                                        <Button Content="移除选中项" Command="{Binding RemoveResourceCommand}" Style="{StaticResource Browse}"/>
                                    </WrapPanel>
                                    <TextBlock Text="稳定 AppId（高级）：每个项目独立保存，升级时保持不变。更改输出文件名不改变 AppId。" Style="{StaticResource Hint}"/>
                                    <TextBox Text="{Binding AppIdText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                        <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0">
                            <StackPanel IsEnabled="{Binding IsExistingMode}">
                                <TextBlock Text="已有脚本保留原 AppId、授权、图标与安装逻辑；上方通用应用信息及额外资源在此模式下不生效。" Style="{StaticResource Hint}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="已有 .iss 脚本" Style="{StaticResource Label}"/>
                                    <TextBox Grid.Column="1" Text="{Binding ExistingScriptPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"/>
                                    <Button Grid.Column="2" Content="浏览" Command="{Binding BrowseScriptCommand}" Style="{StaticResource Browse}"/>
                                    <TextBlock Grid.Row="1" Text="构建输入目录" Style="{StaticResource Label}"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ScriptInputDirectory, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" Margin="0,7,0,0"/>
                                    <Button Grid.Row="1" Grid.Column="2" Content="浏览" Command="{Binding BrowseScriptInputFolderCommand}" Style="{StaticResource Browse}" Margin="8,7,0,0"/>
                                </Grid>
                                <TextBlock Text="输入目录必须与脚本 Source / 宏实际使用的位置匹配；现代项目建议脚本旁 Publish。工具不推断自定义宏。非空输入目录会先确认并备份。首版只支持单 EXE，分卷或必需附属产物会拒绝。需支持 ISPP 有效规则导出；不支持 builtin 或 external / 下载依赖。" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="20,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="4  开始打包" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" Margin="0,3,8,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="开始打包" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" Style="{StaticResource PrimaryButtonStyle}"/>
                    <Button Grid.Column="2" Content="取消" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" Style="{StaticResource Browse}"/>
                    <Button Grid.Column="3" Content="打开输出目录" Command="{Binding OpenOutputDirectoryCommand}" IsEnabled="{Binding HasOutput}" Style="{StaticResource Browse}"/>
                    <Button Grid.Column="4" Content="完整日志" Command="{Binding OpenLogCommand}" IsEnabled="{Binding HasLog}" Style="{StaticResource Browse}"/>
                </Grid>
                <ProgressBar Height="3" IsIndeterminate="{Binding IsBusy}" Minimum="0" Maximum="1" Value="0" Margin="0,8,0,0"/>
                <TextBox Text="{Binding ResultText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" MaxHeight="90" VerticalScrollBarVisibility="Auto" Padding="0" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        <TextBox x:Name="LogBox" Grid.Row="3" Text="{Binding LogText, Mode=OneWay}" Style="{StaticResource LogConsoleStyle}" Margin="20,0,20,14" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextChanged="LogBox_TextChanged" AutomationProperties.Name="打包实时日志"/>
    </Grid>
</local:BasePage>
