<local:BasePage x:Class="烧录上位机程序.Pages.DownloadPage"
                Title="高速下载"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:local="clr-namespace:烧录上位机程序.Pages">
    <Grid Background="{StaticResource PageBgBrush}" Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="高速下载" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="多连接分段下载固件包与工具链，支持断点续传、限速、镜像清单与 SHA-256 校验。下载可与烧录/打包并行。"
                       Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 新建下载 -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="18" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="下载地址（http/https）" Margin="0,0,0,8"/>
                <TextBox Text="{Binding DownloadUrl, UpdateSourceTrigger=PropertyChanged}" MinHeight="36"
                         VerticalContentAlignment="Center" FontFamily="Consolas"
                         AutomationProperties.Name="下载地址"/>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="保存位置" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding DestinationDirectory, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="36" VerticalContentAlignment="Center"
                                     AutomationProperties.Name="下载保存位置"/>
                            <Button Grid.Column="1" Content="浏览…" Command="{Binding BrowseDestinationCommand}"
                                    Margin="10,0,0,0" Style="{StaticResource SecondaryButtonStyle}"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Bottom">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="连接数(1-16)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding ConnectionsText, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="36" VerticalContentAlignment="Center" AutomationProperties.Name="连接数"/>
                            <TextBlock Grid.Column="2" Text="限速(KB/s)" VerticalAlignment="Center" Margin="14,0,8,0"/>
                            <TextBox Grid.Column="3" Text="{Binding MaxRateKBText, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="36" VerticalContentAlignment="Center" AutomationProperties.Name="单任务限速"/>
                            <CheckBox Grid.Column="4" Content="加入后暂停" IsChecked="{Binding StartPaused}"
                                      VerticalAlignment="Center" Margin="14,0,0,0" AutomationProperties.Name="加入后暂停"/>
                        </Grid>
                    </StackPanel>
                    <Button Grid.Column="2" Content="添加下载" Command="{Binding AddDownloadCommand}"
                            Margin="14,0,0,0" VerticalAlignment="Bottom" MinWidth="96"
                            Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.Name="添加下载"/>
                </Grid>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Sha256Text, UpdateSourceTrigger=PropertyChanged}" MinHeight="32"
                             VerticalContentAlignment="Center" FontFamily="Consolas"
                             AutomationProperties.Name="期望 SHA-256"/>
                    <TextBlock Grid.Column="1" Text="期望 SHA-256（可选，64 位十六进制；清单下载会强制校验）"
                               VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 从清单导入 -->
        <Expander Grid.Row="2" Header="从镜像清单导入（manifest.json，多节点自动竞速 + SHA-256 强校验）"
                  Margin="0,0,0,14" IsExpanded="False">
            <Border Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="18">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ManifestUrl, UpdateSourceTrigger=PropertyChanged}" MinHeight="36"
                                 VerticalContentAlignment="Center" FontFamily="Consolas"
                                 AutomationProperties.Name="镜像清单地址"/>
                        <Button Grid.Column="1" Content="加载清单" Command="{Binding LoadManifestCommand}"
                                Margin="12,0,0,0" Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>
                    <TextBlock Text="清单地址必须 https 且为公网节点；文件保存位置沿用上方“保存位置”。"
                               Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    <DataGrid ItemsSource="{Binding ManifestFiles}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" RowHeight="34" Height="180" Margin="0,12,0,0"
                              BorderThickness="1" Background="White" AutomationProperties.Name="清单文件列表">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="导入" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="52"/>
                            <DataGridTextColumn Header="文件名" Binding="{Binding Name, Mode=OneWay}" Width="2.4*"/>
                            <DataGridTextColumn Header="大小" Binding="{Binding SizeText, Mode=OneWay}" Width="*"/>
                            <DataGridTextColumn Header="节点数" Binding="{Binding NodeCount, Mode=OneWay}" Width="60"/>
                            <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256, Mode=OneWay}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Content="导入所选到下载队列" Command="{Binding ImportSelectedCommand}"
                            Margin="0,12,0,0" HorizontalAlignment="Left" MinWidth="160"
                            Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.Name="导入所选清单文件"/>
                </StackPanel>
            </Border>
        </Expander>

        <!-- 下载设置 -->
        <Expander Grid.Row="3" Header="下载设置（连接与并发、全局限速、HTTP 代理）" Margin="0,0,0,14" IsExpanded="False">
            <Border Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="18">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="默认连接数" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding DefaultConnections, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="8,0,0,0" MinHeight="32" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="默认连接数"/>
                        <TextBlock Grid.Column="2" Text="同时下载任务数" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        <TextBox Grid.Column="3" Text="{Binding MaxConcurrentTasks, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="8,0,0,0" MinHeight="32" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="同时下载任务数"/>
                        <TextBlock Grid.Column="4" Text="全局限速(KB/s，0 不限)" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        <TextBox Grid.Column="5" Text="{Binding MaxRateKB, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="8,0,0,0" MinHeight="32" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="全局限速"/>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="HTTP 代理主机" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding ProxyHost, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="8,0,0,0" MinHeight="32" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="HTTP 代理主机"/>
                        <TextBlock Grid.Column="2" Text="端口" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        <TextBox Grid.Column="3" Text="{Binding ProxyPort, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="8,0,0,0" MinHeight="32" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="HTTP 代理端口"/>
                        <Button Grid.Column="4" Content="保存设置" Command="{Binding SaveSettingsCommand}"
                                Margin="16,0,0,0" Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>
                    <TextBlock Text="代理仅支持 HTTP 且不含账号密码（凭据不写入配置文件）；SOCKS 代理暂不支持。设置保存后对之后启动的下载任务生效。"
                               Margin="0,10,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Expander>

        <!-- 任务列表 -->
        <GroupBox Grid.Row="4" Header="下载任务" Margin="0,0,0,14">
            <DataGrid ItemsSource="{Binding Tasks}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="40"
                      BorderThickness="0" Background="White" EnableRowVirtualization="True"
                      SelectionMode="Single" AutomationProperties.Name="下载任务列表">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="文件 / 地址" Binding="{Binding DisplayName, Mode=OneWay}" Width="2.4*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="状态" Binding="{Binding StateText, Mode=OneWay}" Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="ToolTip" Value="{Binding Message, Mode=OneWay}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="进度" Width="1.6*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="8"
                                                 Style="{StaticResource RoundedProgressStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SizeText, Mode=OneWay}" Margin="8,0,0,0"
                                               VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="速度" Binding="{Binding SpeedText, Mode=OneWay}" Width="80"/>
                    <DataGridTextColumn Header="剩余时间" Binding="{Binding EtaText, Mode=OneWay}" Width="80"/>
                    <DataGridTemplateColumn Header="操作" Width="420">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="暂停" Command="{Binding PauseCommand}" MinWidth="46" Height="28"
                                            Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="暂停下载"/>
                                    <Button Content="继续" Command="{Binding ResumeCommand}" MinWidth="46" Height="28" Margin="6,0,0,0"
                                            Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="继续下载"/>
                                    <Button Content="取消" Command="{Binding CancelCommand}" MinWidth="46" Height="28" Margin="6,0,0,0"
                                            Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="取消下载"/>
                                    <Button Content="重试" Command="{Binding RetryCommand}" MinWidth="46" Height="28" Margin="6,0,0,0"
                                            Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="重试下载"/>
                                    <Button Content="打开位置" Command="{Binding OpenFolderCommand}" MinWidth="64" Height="28" Margin="6,0,0,0"
                                            Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="打开下载位置"/>
                                    <Button Content="移除" Command="{Binding RemoveCommand}" MinWidth="46" Height="28" Margin="6,0,0,0"
                                            Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="移除下载记录"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <StackPanel Grid.Row="5">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"
                       AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Text="取消或暂停会保留续传记录（目标旁的 .dltmp / .dltask.json），重新添加同一地址可继续；关闭程序同样保留。"
                       Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</local:BasePage>
