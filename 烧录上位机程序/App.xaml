<Application x:Class="烧录上位机程序.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:烧录上位机程序"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- 主窗口由 App.OnStartup 手动创建，J-Link DLL 在启动烧录时才加载；
         此处不再设 StartupUri，否则会创建第二个主窗口 -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WPF-UI Fluent 2 主题：为 TextBox/ComboBox/RadioButton/ProgressBar 等提供现代外观 -->
                <ui:ThemesDictionary Theme="Light"/>
                <ui:ControlsDictionary/>
                <!-- 自定义样式：分区卡片 / 主次按钮 / 圆角进度条 / 配色 -->
                <ResourceDictionary Source="Resources/UiStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
